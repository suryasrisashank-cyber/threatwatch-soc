# ==============================================================================
# SentinelLab — Backend .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Local SQLite Database Files
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
sentinellab.db
sentinellab_test.db

# Environment Files & Secrets (NEVER COMMIT CREDENTIALS)
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Logs
*.log
logs/
