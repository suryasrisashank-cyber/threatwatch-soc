# ==============================================================================
# ThreatWatch — Global Environment Template
# Copy this file to .env and configure local values as needed.
# NEVER commit actual secrets or credentials to source control.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database Connection (Defaults to zero-config SQLite if omitted)
# For local SQLite: sqlite:///./sentinellab.db
# For PostgreSQL:   postgresql://user:password@localhost:5432/sentinellab
DATABASE_URL=sqlite:///./sentinellab.db

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws/simulation

# Security & Lab Notice
LAB_ENVIRONMENT=AUTHORIZED_LAB_ONLY
