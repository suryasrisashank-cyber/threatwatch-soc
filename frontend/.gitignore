# ==============================================================================
# SentinelLab — Frontend .gitignore
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing
/coverage

# Next.js build output
/.next/
/out/

# Production build artifacts
/build
/dist

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment files (NEVER COMMIT CREDENTIALS)
.env*.local
.env
.env.development
.env.test
.env.production
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts
