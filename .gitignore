# ==============================================================================
# ThreatWatch — Git Ignore Configuration
# Prevents committing secrets, databases, dependencies, and environment files
# ==============================================================================

# Node.js / Next.js
node_modules/
.next/
out/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.turbo/

# Python & FastAPI
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Database Files (Never commit local or production databases)
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
sentinellab.db
sentinellab_test.db

# Environment Variables & Secrets (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
!.env.*.example
*.env
*.pem
*.key
*.cert
*.crt
id_rsa
id_rsa.pub

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# IDEs and Editors
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Log Files & Artifacts
*.log
logs/
.system_generated/
scratch/
